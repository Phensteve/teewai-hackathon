{
  "name": "Zero Scan Nudge",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "zero_scan_nudge",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "nudge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "zeroScanReminder",
            "args": {
              "action": "scheduled"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Email users with zero scans",
            "description": "Branded reminder, spam-safe"
          }
        }
      }
    ]
  },
  "description": "Weekly branded email nudging users who signed up but never took a scan. Anti-spam built in: accounts must be 3+ days old, max 3 nudges per user, at least 7 days apart. Runs every Monday at 10am Africa/Lagos.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * 1",
      "one_time_date": null,
      "timezone": "Africa/Lagos",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}