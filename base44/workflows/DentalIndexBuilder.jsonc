{
  "name": "Dental Index Builder",
  "description": "Builds and refreshes queued grid cells of the dental index in the background",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "dental_index_builder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "build_cells": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dentalIndex",
            "args": {
              "op": "ingest_pending"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Build queued cells",
            "description": "Classify and store dental units"
          }
        }
      }
    ]
  }
}