{
  "name": "Daily Nudges",
  "description": "Sends 8 push notifications a day to native app users \u2014 morning brush, water, daily tip (with teaser), food scan, water, streak, evening scan, night brush. Fires at 7am, 9am, 11am, 1pm, 3pm, 5pm, 7pm, 9pm Africa/Lagos.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7,9,11,13,15,17,19,21 * * *",
      "one_time_date": null,
      "timezone": "Africa/Lagos",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_nudges",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "nudge": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailyNudges",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send daily nudge",
            "description": "Push notification to native app users"
          }
        }
      }
    ]
  }
}