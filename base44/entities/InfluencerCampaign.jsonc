{
  "name": "InfluencerCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "invitation_code": {
      "type": "string"
    },
    "coupon_id": {
      "type": "string"
    },
    "tracking_token": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "tracking_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}