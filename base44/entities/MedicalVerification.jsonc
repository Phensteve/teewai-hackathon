{
  "name": "MedicalVerification",
  "type": "object",
  "title": "Medical Verification",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "full_name": {
      "type": "string",
      "title": "Full name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "profession": {
      "type": "string",
      "title": "Profession",
      "enum": [
        "dentist",
        "dental_hygienist",
        "dental_therapist",
        "orthodontist",
        "oral_surgeon",
        "medical_doctor",
        "pharmacist",
        "other"
      ]
    },
    "profession_other": {
      "type": "string",
      "title": "Profession (if other)"
    },
    "license_number": {
      "type": "string",
      "title": "License / registration number"
    },
    "license_document_url": {
      "type": "string",
      "title": "License document",
      "format": "uri"
    },
    "country": {
      "type": "string",
      "title": "Country of license"
    },
    "specialization": {
      "type": "string",
      "title": "Specialization",
      "maxLength": 300
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed by (admin)"
    },
    "review_notes": {
      "type": "string",
      "title": "Review notes",
      "maxLength": 1000
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted date"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed date"
    }
  },
  "required": [
    "full_name",
    "profession",
    "license_number",
    "country"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}