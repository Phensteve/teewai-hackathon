{
  "name": "DentistClient",
  "type": "object",
  "title": "Dentist Client",
  "properties": {
    "dentist_id": {
      "type": "string",
      "title": "Dentist User ID"
    },
    "client_name": {
      "type": "string",
      "title": "Client Name"
    },
    "client_email": {
      "type": "string",
      "title": "Client Email",
      "format": "email"
    },
    "notes": {
      "type": "string",
      "title": "Clinical Notes"
    }
  },
  "required": [
    "client_name",
    "client_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.dentist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.dentist_id": "{{user.id}}"
        },
        {
          "data.client_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.dentist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.dentist_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}