{
  "name": "BlogVerification",
  "type": "object",
  "title": "Blog Author Verification",
  "properties": {
    "user_id": {
      "type": "string",
      "title": "User ID"
    },
    "full_name": {
      "type": "string",
      "title": "Full name"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "bio": {
      "type": "string",
      "title": "Bio / why you want to write",
      "maxLength": 500
    },
    "sample_url": {
      "type": "string",
      "title": "Sample writing URL",
      "format": "uri"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string",
      "title": "Reviewed by"
    },
    "review_notes": {
      "type": "string",
      "title": "Review notes",
      "maxLength": 1000
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted date"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed date"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "full_name",
    "bio"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}