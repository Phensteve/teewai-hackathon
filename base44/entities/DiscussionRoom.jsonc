{
  "name": "DiscussionRoom",
  "type": "object",
  "title": "Discussion Room",
  "properties": {
    "name": {
      "type": "string",
      "title": "Room Name"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 500
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "general",
        "suggestions",
        "feedback",
        "support",
        "announcements"
      ],
      "default": "general"
    },
    "is_insider": {
      "type": "boolean",
      "title": "Insider Room",
      "description": "When true, only signed-in teewai users can view and post in this room.",
      "default": false
    },
    "is_official": {
      "type": "boolean",
      "title": "Official Room",
      "description": "When true, the room is a teewai-official room (e.g. Insider Updates) managed by admins.",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": null,
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}