{
  "name": "BlogSubmission",
  "type": "object",
  "title": "Blog Submission",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "slug": {
      "type": "string",
      "title": "Slug"
    },
    "excerpt": {
      "type": "string",
      "title": "Excerpt",
      "maxLength": 500
    },
    "content": {
      "type": "string",
      "title": "Content (Markdown)"
    },
    "cover_image_url": {
      "type": "string",
      "title": "Cover image",
      "format": "uri"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "default": "Community"
    },
    "author_id": {
      "type": "string",
      "title": "Author user ID"
    },
    "author_name": {
      "type": "string",
      "title": "Author display name"
    },
    "author_username": {
      "type": "string",
      "title": "Author username"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewer_id": {
      "type": "string",
      "title": "Reviewer admin username"
    },
    "review_notes": {
      "type": "string",
      "title": "Review notes",
      "maxLength": 1000
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time",
      "title": "Submitted date"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date-time",
      "title": "Reviewed date"
    },
    "description": {
      "type": "string",
      "title": "Description",
      "maxLength": 1000
    }
  },
  "required": [
    "title",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}